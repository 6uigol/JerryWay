{
  "name": "jerry-way",
  "private": true,
  "type": "module",
  "version": "1.0.2",
  "description": "Jerry Way — o jogo infinito do Jerry (universo Song of Moonlight)",
  "author": { "name": "Song of Moonlight", "email": "146967020+6uigol@users.noreply.github.com" },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "npx --yes serve -l 8080 .",
    "build:cloud": "esbuild cloud/entry.js --bundle --format=esm --minify --target=chrome120 --outfile=vendor/cloud.bundle.js",
    "icons": "node scripts/make-icons.mjs",
    "build": "electron-builder --win nsis --linux AppImage --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:android": "node scripts/build-android.mjs",
    "test": "node tests/world.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "1.57.0"
  },
  "build": {
    "appId": "com.jerryway.game",
    "buildVersion": "1.0.2.0",
    "productName": "Jerry Way",
    "copyright": "Todos os direitos reservados",
    "directories": { "output": "dist" },
    "files": ["electron/**", "index.html", "style.css", "src/**", "vendor/**", "icons/**", "fonts/**", "package.json", "!**/*.map"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icons/app.ico" },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "icons/icon-512.png", "category": "Game", "executableName": "jerry-way",
      "artifactName": "Jerry-Way-${version}.${ext}",
      "maintainer": "6uigol <146967020+6uigol@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Jerry Way",
      "runAfterFinish": true, "deleteAppDataOnUninstall": false, "language": "1046",
      "artifactName": "Jerry-Way-Setup-${version}.${ext}"
    },
    "electronLanguages": ["pt-BR", "en-US"],
    "compression": "maximum"
  }
}
